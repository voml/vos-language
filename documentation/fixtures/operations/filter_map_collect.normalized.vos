let active_users = User
    .filter(x =>
        x.active &&
        x.user_name != ""
    )
    .sort_by(x => x.user_name)

let public_users = active_users.map(x => x.{
    user_id,
    name: user_name,
    avatar,
})

# Execution boundary — materialize [T].
let users = public_users.collect()

users
