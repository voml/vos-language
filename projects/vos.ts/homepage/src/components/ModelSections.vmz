</style>

<script client>
import {
  homePrimitivesTitle,
  homePrimitivesLede,
  homePrimitiveNamespaceTitle,
  homePrimitiveNamespaceBody,
  homePrimitiveTableTitle,
  homePrimitiveTableBody,
  homePrimitiveReferenceTitle,
  homePrimitiveReferenceBody,
  homePrimitiveServiceTitle,
  homePrimitiveServiceBody,
  homeRelationsTitle,
  homeRelationsLede,
  homeRelationsNote,
  homeLifecycleTitle,
  homeLifecycleLede,
  homeLifecycleDefineTitle,
  homeLifecycleDefineBody,
  homeLifecycleConnectTitle,
  homeLifecycleConnectBody,
  homeLifecycleValidateTitle,
  homeLifecycleValidateBody,
  homeLifecycleEvolveTitle,
  homeLifecycleEvolveBody,
} from '#locales/common';
import { readLocaleId, withLocaleHint, watchDocumentLocale } from '../lib/locale-copy.ts';

export default class ModelSections {
  primitivesTitle = '';
  primitivesLede = '';
  namespaceTitle = '';
  namespaceBody = '';
  tableTitle = '';
  tableBody = '';
  referenceTitle = '';
  referenceBody = '';
  serviceTitle = '';
  serviceBody = '';
  relationsTitle = '';
  relationsLede = '';
  relationsNote = '';
  lifecycleTitle = '';
  lifecycleLede = '';
  defineTitle = '';
  defineBody = '';
  connectTitle = '';
  connectBody = '';
  validateTitle = '';
  validateBody = '';
  evolveTitle = '';
  evolveBody = '';
  _unwatchLocale = null;

  onMount() {
    this.applyLocaleCopy();
    this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
  }

  onDestroy() {
    if (typeof this._unwatchLocale === 'function') this._unwatchLocale();
    this._unwatchLocale = null;
  }

  refreshCopy() {
    this.primitivesTitle = homePrimitivesTitle();
    this.primitivesLede = homePrimitivesLede();
    this.namespaceTitle = homePrimitiveNamespaceTitle();
    this.namespaceBody = homePrimitiveNamespaceBody();
    this.tableTitle = homePrimitiveTableTitle();
    this.tableBody = homePrimitiveTableBody();
    this.referenceTitle = homePrimitiveReferenceTitle();
    this.referenceBody = homePrimitiveReferenceBody();
    this.serviceTitle = homePrimitiveServiceTitle();
    this.serviceBody = homePrimitiveServiceBody();
    this.relationsTitle = homeRelationsTitle();
    this.relationsLede = homeRelationsLede();
    this.relationsNote = homeRelationsNote();
    this.lifecycleTitle = homeLifecycleTitle();
    this.lifecycleLede = homeLifecycleLede();
    this.defineTitle = homeLifecycleDefineTitle();
    this.defineBody = homeLifecycleDefineBody();
    this.connectTitle = homeLifecycleConnectTitle();
    this.connectBody = homeLifecycleConnectBody();
    this.validateTitle = homeLifecycleValidateTitle();
    this.validateBody = homeLifecycleValidateBody();
    this.evolveTitle = homeLifecycleEvolveTitle();
    this.evolveBody = homeLifecycleEvolveBody();
  }

  applyLocaleCopy(preferred) {
    withLocaleHint(readLocaleId(preferred), () => this.refreshCopy());
  }
}
</script>
