  color: var(--vos-ink);
  font-size: 1.1rem;
}

.flow p {
  margin: 0;
  color: var(--vos-muted);
  font-size: 0.92rem;
}

@media (max-width: 960px) {
  .grid,
  .flow {
    grid-template-columns: 1fr 1fr;
  }

  .relations-layout {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .grid,
  .flow {
    grid-template-columns: 1fr;
