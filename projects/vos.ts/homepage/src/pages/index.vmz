  justify-content: space-between;
  gap: 2rem;
  padding-block: clamp(3.5rem, 8vw, 6rem);
}

.final-cta h2 { max-width: 38rem; }

@media (max-width: 1000px) {
  .hero { grid-template-columns: 1fr; min-height: auto; }
  .hero-copy { max-width: 44rem; }
  .model-board { max-width: 54rem; }
  .anatomy, .toolchain { grid-template-columns: 1fr; gap: 2.5rem; }
}

@media (max-width: 760px) {
  .strip-inner, .lifecycle-head, .final-cta { align-items: flex-start; flex-direction: column; }
  .strip-stats { flex-wrap: wrap; gap: 0.8rem 1.4rem; }
  .surface-grid, .lifecycle-track { grid-template-columns: 1fr; }
  .surface-card { min-height: 0; }
  .surface-card h3 { margin-top: 2rem; }
  .lifecycle-track li, .lifecycle-track li + li {
    min-height: 0;
    padding: 1rem 0 1.2rem 1.2rem;
    border-left: 1px solid var(--vos-border);
    border-bottom: 1px solid var(--vos-border);
  }
  .lifecycle-track li:last-child { border-bottom: 0; }
  .step-line, .lifecycle-track li:first-child .step-line { top: 1rem; left: -0.32rem; }
  .lifecycle-track strong { margin-top: 0.7rem; }
  .lifecycle-track p { max-width: none; }
}

@media (max-width: 520px) {
  .hero h1 { font-size: clamp(2.65rem, 14vw, 4rem); }
  .hero { padding-block: 3rem 3.5rem; }
  .model-board { min-height: 28rem; }
  .map { min-height: 20.5rem; }
  .map-node { width: 8rem; padding: 0.65rem 0.7rem; }
  .node-profile { left: 0; }
  .node-session { right: 0; }
  .board-status { margin-left: 0; }
}

@media (prefers-reduced-motion: reduce) {
  .surface-card { transition: none; }
}
</style>

<script client>
import {
  homeHeroKicker,
  homeHeroTitleA,
  homeHeroTitleB,
  homeHeroLede,
  homeHeroMeta,
  homeBoardLabel,
  homeBoardRelation,
  homeBoardPersistent,
  homeBoardReady,
  homeStripTitle,
  homeStripNamespace,
  homeStripRelations,
  homeStripLifecycle,
  homeAnatomyEyebrow,
  homeAnatomyTitle,
  homeAnatomyLede,
  homeAnatomyNote,
  homeSchemaChip,
  homeSchemaCaption,
  homeSurfaceEyebrow,
  homeSurfaceTitle,
  homeSurfaceLede,
  homeSurfaceNamespaceTitle,
  homeSurfaceNamespaceBody,
  homeSurfaceNamespaceCode,
  homeSurfaceTableTitle,
  homeSurfaceTableBody,
  homeSurfaceTableCode,
  homeSurfaceServiceTitle,
  homeSurfaceServiceBody,
  homeSurfaceServiceCode,
  homeLifecycleEyebrow,
  homeLifecycleTitle,
  homeLifecycleLede,
  homeLifecycleDefineTitle,
  homeLifecycleDefineBody,
  homeLifecycleConnectTitle,
  homeLifecycleConnectBody,
  homeLifecycleValidateTitle,
  homeLifecycleValidateBody,
  homeLifecycleEvolveTitle,
  homeLifecycleEvolveBody,
  homeToolchainEyebrow,
  homeToolchainTitle,
  homeToolchainLede,
  homePkgVos,
  homePkgRs,
  homeFinalEyebrow,
  homeFinalTitle,
  homeFinalLede,
  homeFinalCta,
  homeOpenPlayground,
  homeReadModel,
  playgroundCopy,
  titlesHome,
} from '#locales/common';
import { SAMPLE_HERO } from '../lib/samples.ts';
import { readLocaleId, withLocaleHint, watchDocumentLocale } from '../lib/locale-copy.ts';

export default class IndexPage {
  heroKicker = '';
  heroTitleA = '';
  heroTitleB = '';
  heroLede = '';
  heroMeta = '';
  boardLabel = '';
  boardRelation = '';
  boardPersistent = '';
  boardReady = '';
  stripTitle = '';
  stripNamespace = '';
  stripRelations = '';
  stripLifecycle = '';
  anatomyEyebrow = '';
  anatomyTitle = '';
  anatomyLede = '';
  anatomyNote = '';
  schemaChip = '';
  schemaCaption = '';
  surfaceEyebrow = '';
  surfaceTitle = '';
  surfaceLede = '';
  surfaceNamespaceTitle = '';
  surfaceNamespaceBody = '';
  surfaceNamespaceCode = '';
  surfaceTableTitle = '';
  surfaceTableBody = '';
  surfaceTableCode = '';
  surfaceServiceTitle = '';
  surfaceServiceBody = '';
  surfaceServiceCode = '';
  lifecycleEyebrow = '';
  lifecycleTitle = '';
  lifecycleLede = '';
  lifecycleDefineTitle = '';
  lifecycleDefineBody = '';
  lifecycleConnectTitle = '';
  lifecycleConnectBody = '';
  lifecycleValidateTitle = '';
  lifecycleValidateBody = '';
  lifecycleEvolveTitle = '';
  lifecycleEvolveBody = '';
  toolchainEyebrow = '';
  toolchainTitle = '';
  toolchainLede = '';
  pkgVos = '';
  pkgRs = '';
  finalEyebrow = '';
  finalTitle = '';
  finalLede = '';
  finalCta = '';
  openPlayground = '';
  readModel = '';
  copyLabel = 'Copy';
  heroSample = SAMPLE_HERO;
  _unwatchLocale = null;

  onMount() {
    this.applyLocaleCopy();
    this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
  }

  onDestroy() {
    if (typeof this._unwatchLocale === 'function') this._unwatchLocale();
    this._unwatchLocale = null;
  }

  refreshCopy() {
    this.heroKicker = homeHeroKicker();
    this.heroTitleA = homeHeroTitleA();
    this.heroTitleB = homeHeroTitleB();
    this.heroLede = homeHeroLede();
    this.heroMeta = homeHeroMeta();
    this.boardLabel = homeBoardLabel();
    this.boardRelation = homeBoardRelation();
    this.boardPersistent = homeBoardPersistent();
    this.boardReady = homeBoardReady();
    this.stripTitle = homeStripTitle();
    this.stripNamespace = homeStripNamespace();
    this.stripRelations = homeStripRelations();
    this.stripLifecycle = homeStripLifecycle();
    this.anatomyEyebrow = homeAnatomyEyebrow();
    this.anatomyTitle = homeAnatomyTitle();
    this.anatomyLede = homeAnatomyLede();
    this.anatomyNote = homeAnatomyNote();
    this.schemaChip = homeSchemaChip();
    this.schemaCaption = homeSchemaCaption();
    this.surfaceEyebrow = homeSurfaceEyebrow();
    this.surfaceTitle = homeSurfaceTitle();
    this.surfaceLede = homeSurfaceLede();
    this.surfaceNamespaceTitle = homeSurfaceNamespaceTitle();
    this.surfaceNamespaceBody = homeSurfaceNamespaceBody();
    this.surfaceNamespaceCode = homeSurfaceNamespaceCode();
    this.surfaceTableTitle = homeSurfaceTableTitle();
    this.surfaceTableBody = homeSurfaceTableBody();
    this.surfaceTableCode = homeSurfaceTableCode();
    this.surfaceServiceTitle = homeSurfaceServiceTitle();
    this.surfaceServiceBody = homeSurfaceServiceBody();
    this.surfaceServiceCode = homeSurfaceServiceCode();
    this.lifecycleEyebrow = homeLifecycleEyebrow();
    this.lifecycleTitle = homeLifecycleTitle();
    this.lifecycleLede = homeLifecycleLede();
    this.lifecycleDefineTitle = homeLifecycleDefineTitle();
    this.lifecycleDefineBody = homeLifecycleDefineBody();
    this.lifecycleConnectTitle = homeLifecycleConnectTitle();
    this.lifecycleConnectBody = homeLifecycleConnectBody();
    this.lifecycleValidateTitle = homeLifecycleValidateTitle();
    this.lifecycleValidateBody = homeLifecycleValidateBody();
    this.lifecycleEvolveTitle = homeLifecycleEvolveTitle();
    this.lifecycleEvolveBody = homeLifecycleEvolveBody();
    this.toolchainEyebrow = homeToolchainEyebrow();
    this.toolchainTitle = homeToolchainTitle();
    this.toolchainLede = homeToolchainLede();
    this.pkgVos = homePkgVos();
    this.pkgRs = homePkgRs();
    this.finalEyebrow = homeFinalEyebrow();
    this.finalTitle = homeFinalTitle();
    this.finalLede = homeFinalLede();
    this.finalCta = homeFinalCta();
    this.openPlayground = homeOpenPlayground();
    this.readModel = homeReadModel();
    this.copyLabel = playgroundCopy();
    if (typeof document !== 'undefined') {
      document.title = titlesHome();
    }
  }

  applyLocaleCopy(preferred) {
    withLocaleHint(readLocaleId(preferred), () => this.refreshCopy());
  }

  async copyHero() {
    if (typeof navigator === 'undefined' || !navigator.clipboard) return;
    try {
      await navigator.clipboard.writeText(this.heroSample);
    } catch {
      /* ignore */
    }
  }
}
</script>
