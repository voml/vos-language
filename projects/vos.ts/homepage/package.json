{
    "private": true,
    "name": "@game-gpt/vos-homepage",
    "version": "0.1.0",
    "type": "module",
    "description": "VOS homepage — VMZ + @vmz/ui + @vmz/ui-icons dogfood",
    "homepage": "https://vos-language.pages.dev/",
    "scripts": {
        "predev": "pnpm --filter @game-gpt/vos build",
        "dev": "vmz dev . --out-dir dist/browser --target browser",
        "prebuild": "pnpm --filter @game-gpt/vos build",
        "build": "vmz build . --release --out-dir dist/browser --target browser",
        "prebuild:static": "pnpm --filter @game-gpt/vos build",
        "build:static": "vmz check . && vmz build . --release --profile static --out-dir dist/cdn --target browser",
        "check": "vmz check .",
        "serve": "vmz serve . --out-dir dist/browser"
    },
    "dependencies": {
        "@game-gpt/vos": "workspace:*",
        "@vmz/core": "0.1.10",
        "@vmz/ui": "0.1.10",
        "@vmz/ui-icons": "0.1.10"
    },
    "devDependencies": {
        "@vmz/vmz": "0.1.10"
    }
}
