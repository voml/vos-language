{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022"],
        "types": ["node"],
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "declaration": true,
        "isolatedModules": true
    },
    "include": ["src/**/*.ts", "tests/**/*.ts"]
}
