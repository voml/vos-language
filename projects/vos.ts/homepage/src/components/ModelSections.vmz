  max-width: 1120px;
  margin: 0 auto;
  padding: 3.5rem 1.25rem 1rem;
}

.section-head h2 {
  margin: 0;
  color: var(--vos-ink);
  font-size: clamp(1.6rem, 3vw, 2.4rem);
  font-weight: 650;
  letter-spacing: -0.03em;
}

.section-head p {
  margin: 0.85rem 0 0;
  color: var(--vos-muted);
  max-width: 34rem;
  line-height: 1.65;
}

.grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0;
  margin-top: 1.5rem;
  border-top: 1px solid var(--vos-border);
}

.grid article {
  padding: 1.4rem 1.1rem 1.5rem 0;
  border-bottom: 1px solid var(--vos-border);
}

.grid article + article {
  padding-left: 1.15rem;
  border-left: 1px solid var(--vos-border);
}

.mark {
  display: inline-grid;
  place-items: center;
  width: 2.2rem;
  height: 2.2rem;
  margin-bottom: 0.85rem;
  border: 1px solid var(--vos-border);
  font-family: var(--vos-font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.04em;
  color: var(--vos-ink);
  background: var(--vos-surface);
}

.grid article[data-tone='navy'] .mark {
  background: var(--vos-accent);
  border-color: var(--vos-accent);
  color: #18120e;
}

.grid article[data-tone='indigo'] .mark {
  border-color: rgba(156, 140, 255, 0.45);
  color: var(--vos-violet);
}

.grid article[data-tone='cyan'] .mark {
  border-color: rgba(89, 217, 221, 0.45);
  color: var(--vos-cyan);
}

.grid article[data-tone='amber'] .mark {
  border-color: rgba(240, 195, 106, 0.45);
  color: var(--vos-warn);
}

.grid h3 {
  margin: 0 0 0.4rem;
  color: var(--vos-ink);
  font-size: 1.15rem;
}

.grid p,
.note {
  margin: 0;
  color: var(--vos-muted);
  font-size: 0.95rem;
  line-height: 1.55;
}

.relations-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 2rem;
  align-items: center;
  padding: 1.75rem 0;
  border-top: 1px solid var(--vos-border);
  border-bottom: 1px solid var(--vos-border);
}

.note {
  margin-top: 1rem;
  max-width: 28rem;
}

.frame {
  border: 1px solid var(--vos-border);
  background:
    linear-gradient(180deg, rgba(89, 217, 221, 0.08), transparent 55%),
    var(--vos-surface);
}

.flow {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0;
  margin: 1.5rem 0 0;
  padding: 0;
  list-style: none;
  border-top: 1px solid var(--vos-border);
}

.flow li {
  position: relative;
  padding: 1.4rem 1.1rem 1.5rem 0;
  border-bottom: 1px solid var(--vos-border);
}

.flow li + li {
  padding-left: 1.2rem;
  border-left: 1px solid var(--vos-border);
}

.index {
  display: block;
  margin-bottom: 0.55rem;
  font-family: var(--vos-font-mono);
  font-size: 0.75rem;
  letter-spacing: 0.08em;
