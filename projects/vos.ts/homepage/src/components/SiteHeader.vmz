  position: sticky;
  top: 0;
  z-index: 20;
  border-bottom: 1px solid var(--vos-border);
  background: rgba(16, 20, 27, 0.88);
  backdrop-filter: blur(16px);
}

.header-inner {
  display: grid;
  grid-template-columns: minmax(13rem, 1fr) auto minmax(13rem, 1fr);
  align-items: center;
  gap: 1rem;
  width: min(1240px, calc(100% - 3rem));
  min-height: 4.2rem;
  margin-inline: auto;
}

.logo {
  display: inline-flex;
  align-items: center;
  gap: 0.7rem;
  min-width: 0;
  text-decoration: none;
}

.logo-mark {
  color: var(--vos-ink);
  font-family: var(--vos-font-mono);
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: 0.08em;
}

.logo-divider {
  width: 1px;
  height: 1.1rem;
  background: var(--vos-border-strong);
}

.logo-caption {
  overflow: hidden;
  color: var(--vos-muted);
  font-family: var(--vos-font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.04em;
  text-overflow: ellipsis;
  white-space: nowrap;
}

