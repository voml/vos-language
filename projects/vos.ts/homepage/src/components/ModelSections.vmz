      <div class="grid">
        <article data-tone="navy">
          <span class="mark">Ns</span>
          <h3>{namespaceTitle}</h3>
          <p>{namespaceBody}</p>
        </article>
        <article data-tone="indigo">
          <span class="mark">Tb</span>
          <h3>{tableTitle}</h3>
          <p>{tableBody}</p>
        </article>
        <article data-tone="cyan">
          <span class="mark">Rf</span>
          <h3>{referenceTitle}</h3>
          <p>{referenceBody}</p>
        </article>
        <article data-tone="amber">
          <span class="mark">Sv</span>
          <h3>{serviceTitle}</h3>
          <p>{serviceBody}</p>
        </article>
      </div>
    </section>

    <section class="section">
      <div class="relations-layout">
        <div>
          <header class="section-head">
            <h2>{relationsTitle}</h2>
