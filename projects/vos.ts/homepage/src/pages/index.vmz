}

.schema-card-foot span { display: inline-flex; align-items: center; gap: 0.35rem; }

.surfaces { border-bottom: 1px solid var(--vos-border); }
.surface-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.8rem;
  margin-top: 2.2rem;
}

.surface-card {
  min-height: 17.5rem;
  padding: 1.25rem;
  border: 1px solid var(--vos-border);
  background: var(--vos-surface);
  transition: transform 180ms ease, border-color 180ms ease;
}

.surface-card:hover {
  transform: translateY(-4px);
  border-color: var(--vos-accent);
}

.surface-card-top { display: flex; align-items: center; justify-content: space-between; }
.surface-mark {
  display: grid;
  place-items: center;
  width: 2.5rem;
  height: 2.5rem;
  border: 1px solid var(--vos-border-strong);
  color: var(--vos-ink);
  font-family: var(--vos-font-mono);
  font-size: 0.68rem;
}
.surface-index { color: var(--vos-muted); font-family: var(--vos-font-mono); font-size: 0.72rem; }
.surface-card h3 { margin: 3.1rem 0 0.55rem; color: var(--vos-ink); font-size: 1.28rem; font-weight: 650; }
.surface-card p { min-height: 3.3rem; margin: 0; color: var(--vos-muted); font-size: 0.9rem; line-height: 1.55; }
.surface-card code { display: block; margin-top: 1.8rem; color: var(--vos-cyan); font-family: var(--vos-font-mono); font-size: 0.76rem; }
.surface-card[data-tone='cyan'] .surface-mark { border-color: rgba(89, 217, 221, 0.58); color: var(--vos-cyan); }
.surface-card[data-tone='violet'] .surface-mark { border-color: rgba(156, 140, 255, 0.58); color: var(--vos-violet); }
.surface-card[data-tone='orange'] .surface-mark { border-color: rgba(255, 139, 77, 0.58); color: var(--vos-accent); }

.lifecycle { border-bottom: 1px solid var(--vos-border); }
.lifecycle-head { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
.lifecycle-note { max-width: 23rem; margin: 0; color: var(--vos-muted); line-height: 1.65; }
.lifecycle-track {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0;
  margin: 2.7rem 0 0;
  padding: 0;
  list-style: none;
  border-top: 1px solid var(--vos-border-strong);
}
.lifecycle-track li { position: relative; min-height: 9rem; padding: 1rem 1.2rem 0 0; }
.lifecycle-track li + li { padding-left: 1.2rem; border-left: 1px solid var(--vos-border); }
.step-number { color: var(--vos-accent); font-family: var(--vos-font-mono); font-size: 0.7rem; }
.step-line {
  position: absolute;
  top: -0.32rem;
  left: 0;
  width: 0.6rem;
  height: 0.6rem;
  border: 2px solid var(--vos-accent);
  background: var(--vos-page);
  transform: rotate(45deg);
}
.lifecycle-track li:first-child .step-line { left: -0.02rem; }
.lifecycle-track strong { display: block; margin-top: 1.55rem; color: var(--vos-ink); font-size: 1.05rem; }
.lifecycle-track p { max-width: 12rem; margin: 0.4rem 0 0; color: var(--vos-muted); font-size: 0.82rem; line-height: 1.5; }

.toolchain {
  display: grid;
  grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
  gap: clamp(2rem, 8vw, 8rem);
