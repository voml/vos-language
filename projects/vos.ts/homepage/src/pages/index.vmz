.package-stack p { margin: 0.8rem 0 0.75rem 2.7rem; color: var(--vos-muted); font-size: 0.87rem; }
.package-role { display: block; margin-left: 2.7rem; color: var(--vos-cyan); font-size: 0.62rem; font-family: var(--vos-font-mono); letter-spacing: 0.08em; }

.final-cta {
