  font-size: 0.74rem;
  line-height: 1.5;
}

.intro-note span { color: var(--vos-accent); font-size: 1rem; }

.schema-card {
  overflow: hidden;
  border: 1px solid var(--vos-border);
  background: var(--vos-surface);
  box-shadow: 0 1.2rem 3rem rgba(3, 7, 14, 0.16);
}

.schema-card-head {
  padding: 0.8rem 1rem;
  border-bottom: 1px solid var(--vos-border);
  background: var(--vos-surface-2);
}

.mono { color: var(--vos-ink); font-family: var(--vos-font-mono); font-size: 0.76rem; }
.schema-chip {
  padding: 0.2rem 0.45rem;
  color: var(--vos-cyan);
  border: 1px solid rgba(89, 217, 221, 0.38);
  font-family: var(--vos-font-mono);
