namespace demo::vault

class Account {
    [primary] id: uuid,
    email: utf8,
}

table Ledger {
    owner: Account,
    [primary] id: uuid,
}

[effect(read)] [capability(search)] [capability(storage)]
query fetch(id: uuid) -> Account? { Account }

[effect(write)] [capability(storage)]
query record(account: Account) -> Ledger { Ledger }

service Vault {
    fetch(id: uuid) -> Account?
    record(account: Account) -> Ledger
}
