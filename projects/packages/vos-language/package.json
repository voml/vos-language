{
    "name": "@voml/vos-language",
    "version": "0.0.3",
    "description": "VOS language tooling — source checks, catalog projection and formatting backed by the Rust WebAssembly core",
    "homepage": "https://vos-language.pages.dev/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/voml/vos-language.git",
        "directory": "projects/packages/vos-language"
    },
    "type": "module",
    "license": "MPL-2.0",
    "sideEffects": [
        "./lib/vos_wasm.js"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./formatter": {
            "types": "./dist/formatter.d.ts",
            "import": "./dist/formatter.js",
            "default": "./dist/formatter.js"
        },
        "./wasm": "./lib/vos_wasm_bg.wasm"
    },
    "files": [
        "dist",
        "lib",
        "README.md"
    ],
    "scripts": {
        "build:wasm": "node ../../../scripts/build-wasm.mjs",
        "build:ts": "tsc -p tsconfig.build.json",
        "build": "pnpm run build:wasm && pnpm run build:ts",
        "pretypecheck": "pnpm run build:wasm",
        "typecheck": "tsc --noEmit",
        "pretest": "pnpm run build:wasm",
        "test": "vitest run"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "typescript": "^5.9.2",
        "vitest": "^3.2.4"
    }
}
