    <section class="section">
      <header class="section-head">
        <h2>{lifecycleTitle}</h2>
        <p>{lifecycleLede}</p>
      </header>
      <ol class="flow">
        <li>
          <span class="index">01</span>
          <strong>{defineTitle}</strong>
          <p>{defineBody}</p>
        </li>
        <li>
          <span class="index">02</span>
          <strong>{connectTitle}</strong>
          <p>{connectBody}</p>
        </li>
        <li>
          <span class="index">03</span>
          <strong>{validateTitle}</strong>
          <p>{validateBody}</p>
        </li>
        <li>
          <span class="index">04</span>
          <strong>{evolveTitle}</strong>
          <p>{evolveBody}</p>
