</style>

<script client>
import {
  brandShort,
  brandFull,
  navHome,
  navModel,
  navPlayground,
  navTry,
  navPrimary,
  selectLanguage,
  langZh,
  langZhFull,
  langEn,
} from '#locales/common';
import { readLocaleId, withLocaleHint, watchDocumentLocale } from '../lib/locale-copy.ts';

export default class SiteHeader {
  localeId = 'zh-hans';
  brandShortLabel = '';
  brandFullLabel = '';
  homeAriaLabel = '';
  navHomeLabel = '';
  navModelLabel = '';
  navPlaygroundLabel = '';
  navTryLabel = '';
  navPrimaryLabel = '';
  selectLanguageLabel = '';
  langSummary = '';
  langZhFullLabel = '';
  langEnLabel = '';
  _unwatchLocale = null;

  onMount() {
    this.applyLocaleCopy();
    this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
  }

  onDestroy() {
    if (typeof this._unwatchLocale === 'function') this._unwatchLocale();
    this._unwatchLocale = null;
  }

  refreshCopy() {
    this.brandShortLabel = brandShort();
    this.brandFullLabel = brandFull();
    this.homeAriaLabel = `${brandShort()} home`;
    this.navHomeLabel = navHome();
    this.navModelLabel = navModel();
    this.navPlaygroundLabel = navPlayground();
    this.navTryLabel = navTry();
    this.navPrimaryLabel = navPrimary();
    this.selectLanguageLabel = selectLanguage();
    this.langSummary = this.localeId === 'en-us' ? langEn() : langZh();
    this.langZhFullLabel = langZhFull();
    this.langEnLabel = langEn();
  }

  applyLocaleCopy(preferred) {
    this.localeId = readLocaleId(preferred);
    withLocaleHint(this.localeId, () => this.refreshCopy());
  }

  async switchLocale(to) {
    if (typeof window === 'undefined') return;
    const fn = window.__vmzTransitionLocale;
    if (typeof fn !== 'function') return;
    const r = await fn(to);
    if (r && r.status === 'committed') {
      this.applyLocaleCopy(to);
      queueMicrotask(() => this.applyLocaleCopy(to));
    }
  }
}
</script>
