  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1.45rem;
}

.nav a {
  position: relative;
  padding: 1.45rem 0;
  color: var(--vos-muted);
  font-size: 0.83rem;
  font-weight: 600;
  text-decoration: none;
}

.nav a:hover {
  color: var(--vos-ink);
}

.header-aside {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 0.7rem;
}

.header-status {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  color: var(--vos-muted);
  font-family: var(--vos-font-mono);
  font-size: 0.62rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.header-status i {
  width: 0.38rem;
  height: 0.38rem;
  border-radius: 999px;
  background: var(--vos-ok);
  box-shadow: 0 0 0 0.22rem rgba(102, 211, 154, 0.12);
}

.site-language {
  position: relative;
}

.site-language summary {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  list-style: none;
  cursor: pointer;
  color: var(--vos-muted);
  font-size: 0.78rem;
}

.site-language summary::-webkit-details-marker {
  display: none;
}

.site-language__menu {
  position: absolute;
  right: 0;
  top: calc(100% + 0.4rem);
  display: grid;
  min-width: 8rem;
  padding: 0.35rem;
  border: 1px solid var(--vos-border);
  background: var(--vos-surface);
  z-index: 30;
}

.site-language__menu button {
  appearance: none;
  border: 0;
  background: transparent;
  color: var(--vos-ink);
  text-align: left;
  padding: 0.45rem 0.55rem;
  cursor: pointer;
}

.site-language__menu button[aria-current='true'],
.site-language__menu button:hover {
  background: var(--vos-surface-2);
}

.header-cta {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  min-height: 2.25rem;
  padding: 0 0.8rem;
  background: var(--vos-accent);
  color: #18120e;
  font-size: 0.78rem;
  font-weight: 700;
  text-decoration: none;
}

.header-cta:hover {
  background: #ffa16e;
}

@media (max-width: 980px) {
  .header-inner {
    grid-template-columns: auto 1fr auto;
  }

  .header-status,
  .logo-caption,
  .logo-divider {
    display: none;
  }

  .nav {
    justify-content: flex-end;
  }
}

@media (max-width: 700px) {
  .header-inner {
    width: min(100% - 2rem, 42rem);
    grid-template-columns: auto 1fr;
    padding-block: 0.7rem;
  }

  .nav {
    grid-column: 1 / -1;
    grid-row: 2;
    justify-content: flex-start;
    gap: 1.1rem;
    overflow-x: auto;
  }

  .nav a {
    padding: 0.2rem 0 0.65rem;
